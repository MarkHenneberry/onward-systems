# Resend API key — get yours at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified "from" address in Resend (must match a verified domain)
# Use onboarding@resend.dev for local testing (only delivers to your own verified email)
RESEND_FROM=noreply@onwardsystems.ca

# Supabase — get these from your project settings at supabase.com
# URL is safe to expose; service role key is SECRET — never use in client components
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
